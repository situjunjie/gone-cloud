TZ=Asia/Shanghai
SPRING_PROFILE=local

# 镜像信息。Jenkins 部署时会自动注入 IMAGE_TAG
IMAGE_REPO_PREFIX=gone-cloud
IMAGE_TAG=latest

# MySQL
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=ruoyi-vue-pro
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456
MYSQL_SLAVE_HOST=host.docker.internal
MYSQL_SLAVE_PORT=3306
MYSQL_SLAVE_USERNAME=root
MYSQL_SLAVE_PASSWORD=123456

# Redis
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# Nacos（网关与拆分服务需要）
NACOS_SERVER_ADDR=host.docker.internal:8848
NACOS_NAMESPACE=dev
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=
NACOS_PASSWORD=

# XXL Job
XXL_JOB_ENABLED=false
XXL_JOB_ADMIN_ADDRESSES=http://host.docker.internal:9090/xxl-job-admin
XXL_JOB_ACCESS_TOKEN=default_token
# 兼容旧配置名；新环境请使用 XXL_JOB_ACCESS_TOKEN
# XXL_JOB_ACCESSTOKEN=default_token

# MQ / 其它中间件
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092
ROCKETMQ_NAME_SERVER=host.docker.internal:9876

# 端口映射。只会对实际部署的服务生效
HOST_PORT_YUDAO_SERVER=58080
HOST_PORT_GATEWAY_SERVER=48080
HOST_PORT_SYSTEM_SERVER=48081
HOST_PORT_INFRA_SERVER=48082
HOST_PORT_BPM_SERVER=48083
